# zonyx-core environment variables — copy to .env and fill in.
# `air` and `make dev` source this file on startup.

# ---- already wired ----------------------------------------------------------

# Logged on startup; informational only.
SERVICE_NAME=zonyx-core

# slog level: DEBUG / INFO / WARN / ERROR. Empty = INFO.
LOG_LEVEL=DEBUG

# gRPC listen port.
PORT=8080

# UDP address the QUUPPA provider binds to.
QUUPPA_LISTEN_ADDR=:9090

# NATS JetStream connection.
NATS_URL=nats://localhost:4222

# ---- Docker build ------------------------------------------------------------
# go mod download needs GitHub SSH access to fetch private modules.
# Ensure your key is loaded in ssh-agent before building:
#   ssh-add ~/.ssh/id_ed25519   # or your key path
# docker-compose and `make docker` forward the agent socket automatically.
